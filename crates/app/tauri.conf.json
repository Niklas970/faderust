{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Faderust",
  "version": "0.1.0",
  "identifier": "io.github.niklas970.faderust",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Faderust",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
