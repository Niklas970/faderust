{
  "name": "faderust-streamdeck",
  "version": "0.3.1",
  "private": true,
  "description": "Stream Deck plugin for Faderust",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.*",
    "pack": "streamdeck pack com.niklas970.faderust.sdPlugin --output dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "rollup": "^4.65.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
